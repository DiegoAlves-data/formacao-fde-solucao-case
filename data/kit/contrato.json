   "rls": "ligado em toda tabela",
   "politicas": "nenhuma",
   "leitura_chave_publica": "zero linhas"
 },
 "frescor": {
   "regra": "Depois de cada merge na main, o fluxo do GitHub Actions aplica as migrações e refaz a carga; ao fim da execução, o Supabase é igual a data/kit/ no topo da main.",
   "janela": "uma execução do fluxo por merge que toque supabase/**, data/kit/** ou a carga",
   "dados": "estáticos"
 },
 "completude": {
   "regra": "cada tabela tem tantos registros quanto a regra de contagem diz, aplicada ao arquivo da fonte",
