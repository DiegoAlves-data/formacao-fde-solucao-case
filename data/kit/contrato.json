     "registros": "número de registros do nível mais alto do arquivo",
     "itens": "soma do tamanho do campo itens de todos os registros do arquivo",
     "objeto_unico": "1: o arquivo é um objeto só e vira uma linha",
     "chaves_do_objeto": "número de chaves do objeto: cada chave vira uma linha"
  }
 },
 "reconciliacao": {
   "tolerancia": "0.00",
